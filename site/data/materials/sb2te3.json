 is bonded to six equivalent Sb(1) atoms to form edge-sharing TeSb6 octahedra. In the second Te site, Te(1) is bonded in a distorted T-shaped geometry to three equivalent Sb(1) atoms.","dimensionality":2,"mineral":null,"mineral_distance":-1,"tool":"robocrystallographer","doi":"10.1557/mrc.2019.94"},"polyhedra":{"types":[{"type_id":"Sb1-Te6","center":"Sb","wyckoff":"6c","ligand_formula":"Te6","connectivity":{"corner":3.0,"edge":9.0},"n_instances":6,"cn":6,"shape":"octahedron","avg_bond":3.074583,"volume":38.633738,"distortion":0.023576,"econ":5.873567,"qe":1.002602,"bav":7.253227,"bvs":2.713115},{"type_id":"Te3-Sb6","center":"Te","wyckoff":"3a","ligand_formula":"Sb6","connectivity":{"edge":6.0},"n_instances":3,"cn":6,"shape":"octahedron","avg_bond":3.147071,"volume":41.202441,"distortion":0.0,"econ":6.0,"qe":1.00575,"bav":21.510355,"bvs":2.188278}],"sites":[{"label":"Sb1","element":"Sb","wyckoff":"6c","site_symmetry":"3m","oxidation_state":3.0,"cn":6,"ligands":"Te6","shape":"octahedron","polyhedron":true,"reason":"ok"},{"label":"Te1","element":"Te","wyckoff":"6c","site_symmetry":"3m","oxidation_state":-2.0,"cn":3,"ligands":"Sb3","shape":"planar","polyhedron":false,"reason":"only 3 ligand(s): too few to enclose a volume"},{"label":"Te3","element":"Te","wyckoff":"3a","site_symmetry":"-3m","oxidation_state":-2.0,"cn":6,"ligands":"Sb6","shape":"octahedron","polyhedron":true,"reason":"ok"}],"crystal_chemistry":{"pauling_rule_1_radius_ratio":[{"site":"Sb 6c","radius_ratio":0.3439,"predicted_cn":4,"observed_cn":6,"agrees":true}],"pauling_rule_2_electrostatic_valence":[{"site":"Te 6c","sum_of_electrostatic_bond_strengths":1.5,"anion_charge":2.0,"relative_deviation":-0.25,"satisfied":false},{"site":"Te 3a","sum_of_electrostatic_bond_strengths":3.0,"anion_charge":2.0,"relative_deviation":0.5,"satisfied":false}],"pauling_rule_3_polyhedron_sharing":{"Sb-Sb":{"corner":18,"edge":54,"face":0}},"pauling_rule_4_high_valence_sharing":[],"pauling_rule_5_parsimony":{"Sb":1,"Te":1},"bond