 is bonded to three equivalent Mn(1) and three equivalent Bi(1) atoms to form a mixture of distorted corner and edge-sharing TeMn3Bi3 octahedra. The corner-sharing octahedra are not tilted.","dimensionality":2,"mineral":null,"mineral_distance":-1,"tool":"robocrystallographer","doi":"10.1557/mrc.2019.94"},"polyhedra":{"types":[{"type_id":"Mn1-Te6","center":"Mn","wyckoff":"3a","ligand_formula":"Te6","connectivity":{"edge":6.0},"n_instances":3,"cn":6,"shape":"octahedron","avg_bond":2.944842,"volume":33.538227,"distortion":0.0,"econ":6.0,"qe":1.010159,"bav":33.601567,"bvs":1.941664},{"type_id":"Bi1-Te6","center":"Bi","wyckoff":"6c","ligand_formula":"Te6","connectivity":{"edge":6.0},"n_instances":6,"cn":6,"shape":"octahedron","avg_bond":3.192919,"volume":42.983184,"distortion":0.038028,"econ":5.649072,"qe":1.00793,"bav":22.932641,"bvs":2.842608},{"type_id":"Te3-Bi3Mn3","center":"Te","wyckoff":"6c","ligand_formula":"Bi3Mn3","connectivity":{"edge":9.0,"corner":3.0},"n_instances":6,"cn":6,"shape":"octahedron","avg_bond":3.129605,"volume":40.436785,"distortion":0.059037,"econ":5.110271,"qe":1.010644,"bav":24.89595,"bvs":1.941697}],"sites":[{"label":"Mn1","element":"Mn","wyckoff":"3a","site_symmetry":"-3m","oxidation_state":2.0,"cn":6,"ligands":"Te6","shape":"octahedron","polyhedron":true,"reason":"ok"},{"label":"Bi1","element":"Bi","wyckoff":"6c","site_symmetry":"3m","oxidation_state":3.0,"cn":6,"ligands":"Te6","shape":"octahedron","polyhedron":true,"reason":"ok"},{"label":"Te1","element":"Te","wyckoff":"6c","site_symmetry":"3m","oxidation_state":-2.0,"cn":3,"ligands":"Bi3","shape":"planar","polyhedron":false,"reason":"only 3 ligand(s): too few to enclose a volume"},{"label":"Te3","element":"Te","wyckoff":"6c","site_symmetry":"3m","oxidation_state":-2.0,"cn":6,"ligands":"Bi3Mn3","shape":"octahedron","polyhedron":true,"reason":"ok"}],"crystal_chemistry":{"pauling_rule_1_radius_ratio":[{"site":"Mn 3a","radius_ratio":0.3756,"predicted_cn":4,"observed_cn":6,"agrees":true},{"site