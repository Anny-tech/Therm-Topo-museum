nt Mg(2)Sb4 tetrahedra, edges with three equivalent Mg(1)Sb6 octahedra, and edges with three equivalent Mg(2)Sb4 tetrahedra. The corner-sharing octahedral tilt angles range from 11-58°. There are three shorter (2.82 Å) and one longer (2.94 Å) Mg(2)-Sb(1) bond length. Sb(1) is bonded to three equivalent Mg(1) and four equivalent Mg(2) atoms to form a mixture of distorted corner and edge-sharing SbMg7 pentagonal bipyramids.","dimensionality":3,"mineral":null,"mineral_distance":-1,"tool":"robocrystallographer","doi":"10.1557/mrc.2019.94"},"polyhedra":{"types":[],"sites":[{"label":"Mg1","element":"Mg","wyckoff":"1a","site_symmetry":"-3m.","oxidation_state":2.0,"cn":0,"ligands":"","shape":"none","polyhedron":false,"reason":"no ligands found"},{"label":"Mg2","element":"Mg","wyckoff":"2d","site_symmetry":"3m.","oxidation_state":2.0,"cn":0,"ligands":"","shape":"none","polyhedron":false,"reason":"no ligands found"},{"label":"Sb1","element":"Sb","wyckoff":"2d","site_symmetry":"3m.","oxidation_state":-3.0,"cn":0,"ligands":"","shape":"none","polyhedron":false,"reason":"no ligands found"}],"crystal_chemistry":{"pauling_rule_1_radius_ratio":[],"pauling_rule_2_electrostatic_valence":[],"pauling_rule_3_polyhedron_sharing":{},"pauling_rule_4_high_valence_sharing":[],"pauling_rule_5_parsimony":{},"bond_valence_sums":[],"global_instability_index":null,"bond_count_balance":{"cation_side":0,"anion_side":0,"balanced":true},"site_symmetry_consistent":true},"motifs":[],"shapes":[],"files":{"viewer":"data/polyhedra/mg3sb2.html","json":"data/polyhedra/mg3sb2.json","polyhedra":"data/polyhedra/mg3sb2_polyhedra.csv","types":"data/polyhedra/mg3sb2_types.csv","sites":"data/polyhedra/mg3sb2_sites.csv","bonds":"data/polyhedra/mg3sb2_bonds.csv"},"tool":"Crystal-GENUI","url":"https://github.com/Anny-tech/Crystal-GENUI","settings":{"method":"shannon","centers":["Mg","Sb"],"ligands":null,"max_bond":null,"min_bond":0.0,"radius_tolerance":0.15,"include_element_shells":false,"oxidation_states":{"Mg":2.0,"